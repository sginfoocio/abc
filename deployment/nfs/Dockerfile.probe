ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nfs-common iproute2 \
    && rm -rf /var/lib/apt/lists/*
COPY nfs_isolated_probe.py /probe-code/nfs_isolated_probe.py
COPY nfs_repository_guard.py /probe-code/nfs_repository_guard.py
CMD ["sleep", "600"]
